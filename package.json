{
  "name": "tarot-site",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "塔罗牌抽牌应用 —— Cloudflare Pages Functions + D1（原生 JS 前端，无框架无打包）",
  "scripts": {
    "dev": "wrangler pages dev",
    "deploy": "wrangler pages deploy",
    "db:create": "wrangler d1 create tarot-db",
    "db:migrate:local": "wrangler d1 execute tarot-db --local --file=./schema.sql",
    "db:migrate:remote": "wrangler d1 execute tarot-db --remote --file=./schema.sql"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3"
  },
  "devDependencies": {
    "wrangler": "^3.90.0"
  }
}
